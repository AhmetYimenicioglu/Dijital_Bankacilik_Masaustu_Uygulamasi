<Window x:Class="CyberBank.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CyberBank.Views"
        Title="CyberBank | Dijital Bankacılık Masaüstü Uygulaması"
        Height="820" Width="1280"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgApp}">
    <Grid>
        <!-- Login Container (Displayed when not logged in) -->
        <Grid x:Name="LoginContainer" Visibility="Visible">
            <views:LoginView x:Name="LoginControl"/>
        </Grid>

        <!-- Main Application Shell (Displayed after successful login) -->
        <Grid x:Name="MainShell" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="18,20,18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource BrushBrandGradient}" Margin="0,0,12,0">
                                <TextBlock Text="CB" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CYBERBANK" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Dijital Bankacılık" FontSize="11" Foreground="{StaticResource BrushCyan}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="ANA MENÜ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}" Margin="10,0,0,10"/>

                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" IsChecked="True" Click="Nav_Click" Tag="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Ana Sayfa" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTransfer" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Transfer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💸" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Para Transferi (FAST)" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavCards" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Cards">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💳" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Kartlarım &amp; Güvenlik" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTransactions" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Transactions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Hesap Hareketleri" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavExchange" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Exchange">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💱" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Döviz &amp; Altın" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavBills" Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Bills">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="Fatura Ödeme" FontSize="14"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- User Profile & Logout -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}" Padding="12" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Width="38" Height="38" CornerRadius="19" Background="#0F766E" Margin="0,0,10,0">
                                <TextBlock Text="CB" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUserFullName" Text="Demo Müşteri" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock x:Name="TxtUserCustomerNo" Text="No: 8249103" FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>

                            <!-- Logout -->
                            <Button Grid.Column="2" Content="🚪" Style="{StaticResource SecondaryButton}" Padding="6,4" ToolTip="Güvenli Çıkış" Click="BtnLogout_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0" Background="{StaticResource BrushBgSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="28,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderTitle" Text="Finansal Gösterge Paneli" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <Border Background="#13362E" CornerRadius="8" Padding="8,3" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="🟢 Sistem Çevrimiçi" FontSize="11" Foreground="#10B981" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#1A2D4E" CornerRadius="8" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="⚡ FAST 7/24 Aktif" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Date / Time -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCurrentDateTime" Text="12 Eylül 2026, 14:30" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamic View Host -->
                <ContentControl Grid.Row="1" x:Name="ViewHost" Margin="0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
