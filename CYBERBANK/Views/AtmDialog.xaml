<Window x:Class="CyberBank.Views.AtmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberBank Dijital ATM" Height="450" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBgApp}">
    <Border Padding="24">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrushBrandGradient}" Margin="0,0,12,0">
                    <TextBlock Text="🏧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CyberBank Dijital ATM" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Hesaba Para Yatırma &amp; Para Çekme" FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Account Selection -->
            <TextBlock Text="İşlem Yapılacak Hesap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbAccounts" Height="40" Margin="0,0,0,16" DisplayMemberPath="Name" SelectedValuePath="Iban"/>

            <!-- Action Type Toggle -->
            <TextBlock Text="İşlem Türü" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="RbDeposit" Content="📥 Para Yatır" IsChecked="True" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="RbWithdraw" Grid.Column="1" Content="📤 Para Çek" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
            </Grid>

            <!-- Amount Input -->
            <TextBlock Text="Tutar (₺)" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtAmount" Style="{StaticResource ModernTextBox}" Height="44" FontSize="16" FontWeight="SemiBold" Text="1000" Margin="0,0,0,12"/>

            <!-- Quick Amount Badges -->
            <WrapPanel Margin="0,0,0,20">
                <Button Content="₺ 200" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5" Click="QuickAmount_Click"/>
                <Button Content="₺ 500" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5" Click="QuickAmount_Click"/>
                <Button Content="₺ 1.000" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5" Click="QuickAmount_Click"/>
                <Button Content="₺ 2.500" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5" Click="QuickAmount_Click"/>
                <Button Content="₺ 5.000" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5" Click="QuickAmount_Click"/>
            </WrapPanel>

            <!-- Submit Button -->
            <Button Content="İşlemi Onayla ve Tamamla" Style="{StaticResource PrimaryButton}" Height="46" FontSize="14" Click="BtnConfirm_Click"/>
        </StackPanel>
    </Border>
</Window>
