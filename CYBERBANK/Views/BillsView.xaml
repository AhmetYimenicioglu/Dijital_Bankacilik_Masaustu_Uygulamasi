<UserControl x:Class="CyberBank.Views.BillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,20,28,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Registered Bills -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Text="Kayıtlı Faturalarım" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                <TextBlock Text="Ödeme bekleyen elektrik, su, doğalgaz ve iletişim faturaları" FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,20"/>

                <ItemsControl x:Name="BillsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,12" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Width="46" Height="46" CornerRadius="12" Background="#162A45" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconText}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Provider & Sub No -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Provider}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="Abone No: " FontSize="11.5" Foreground="{StaticResource BrushTextMuted}"/>
                                            <TextBlock Text="{Binding SubscriberNo}" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" FontWeight="Medium"/>
                                            <TextBlock Text=" | Son Gün: " FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding DueDate}" FontSize="11.5" Foreground="#F59E0B" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Amount -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" HorizontalAlignment="Right">
                                        <TextBlock Text="Tutar" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2} ₺'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <!-- Pay Button or Paid Badge -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <Button Content="Hemen Öde" Style="{StaticResource PrimaryButton}" Padding="14,8" FontSize="12.5" Click="BtnPayBill_Click" Tag="{Binding}"
                                                Visibility="{Binding IsPaid, Converter={StaticResource InverseBoolToVis}}"/>
                                        <Border Background="#13362E" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="12,6"
                                                Visibility="{Binding IsPaid, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="✓ ÖDENDİ" Foreground="#10B981" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Right: Quick Bill Query Form -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Yeni Fatura Sorgula &amp; Öde" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4"/>
                <TextBlock Text="Kurum seçerek abone numaranızla anında borç sorgulayın" FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,20"/>

                <Border Style="{StaticResource CardPanel}" Padding="20">
                    <StackPanel>
                        <!-- Institution Type -->
                        <TextBlock Text="Kurum Kategorisi" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbBillCategory" Height="42" Margin="0,0,0,16">
                            <ComboBoxItem Content="Elektrik (Enerjisa, CK Boğaziçi)" IsSelected="True"/>
                            <ComboBoxItem Content="Su &amp; Kanalizasyon (İSKİ, ASKİ, İZSU)"/>
                            <ComboBoxItem Content="Doğalgaz (İGDAŞ, BaşkentGaz)"/>
                            <ComboBoxItem Content="Telekomünikasyon (Türk Telekom, Turkcell, Vodafone)"/>
                            <ComboBoxItem Content="Televizyon / Dijital (Digiturk, D-Smart)"/>
                        </ComboBox>

                        <!-- Subscriber Number -->
                        <TextBlock Text="Tesisat / Abone No" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtSubNo" Style="{StaticResource ModernTextBox}" Height="42" Margin="0,0,0,16"/>

                        <!-- Payment Source -->
                        <TextBlock Text="Ödeme Yapılacak Hesap" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbPaymentAccount" Height="42" Margin="0,0,0,20" DisplayMemberPath="Name"/>

                        <Button Content="🔍 Fatura Borcunu Sorgula" Style="{StaticResource PrimaryButton}" Height="46" FontSize="14" Click="BtnQueryBill_Click"/>
                    </StackPanel>
                </Border>

                <!-- Automatic Payment Info Banner -->
                <Border CornerRadius="14" Padding="18" Margin="0,20,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E1B4B" Offset="0"/>
                            <GradientStop Color="#312E81" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="💡" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Otomatik Ödeme Talimatı" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Faturalarınız için otomatik ödeme talimatı vererek gecikme faizi ödemeden faturalarınızın günü gününe vadesiz hesabınızdan ödenmesini sağlayabilirsiniz."
                                   TextWrapping="Wrap" FontSize="12" Foreground="#C7D2FE" LineHeight="17"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
